# nginx gateway for the Habit Tracker (config TEMPLATE).
#
# Serves the built Vite SPA and reverse-proxies API traffic to the two backend
# services by path. Same-origin, so the browser makes plain "/api/..." calls
# with no CORS.
#
# This file is installed as /etc/nginx/templates/default.conf.template. The
# official nginx image's entrypoint runs envsubst over it at container start and
# writes the result to /etc/nginx/conf.d/default.conf. ONLY the three variables
# named in NGINX_ENVSUBST_FILTER (see deploy/Dockerfile) are substituted; every
# other dollar-variable below belongs to nginx and is left untouched.
#
#   DNS_RESOLVER           DNS server nginx asks at request time
#                          (local: Docker's 127.0.0.11, AWS: the VPC resolver)
#   HABIT_CORE_UPSTREAM    host:port of habit-core
#   NOTIFICATIONS_UPSTREAM host:port of notifications
#
# Upstreams are resolved at REQUEST TIME via the resolver above rather than once
# at startup. This is deliberate: containers/tasks get new IPs when they restart,
# and a statically-resolved upstream would keep routing to a dead (or worse,
# reused) IP. The `set $var` + variable `proxy_pass` forces re-resolution.

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    resolver ${DNS_RESOLVER} valid=10s ipv6=off;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # Load balancer health check. Answered by nginx itself: never proxied, so it
    # stays green even when the upstreams are down.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Notifications service. Regex captures the path suffix; checked before the
    # generic /api/ rule below. "/api/notifications[...]" -> "/notifications[...]".
    location ~ ^/api/notifications(?<suffix>/.*)?$ {
        set $notifications_up http://${NOTIFICATIONS_UPSTREAM};
        proxy_pass $notifications_up/notifications$suffix$is_args$args;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Everything else under /api/ -> habit-core. "/api/habits" -> "/habits".
    location ~ ^/api/(?<path>.*)$ {
        set $habit_core_up http://${HABIT_CORE_UPSTREAM};
        proxy_pass $habit_core_up/$path$is_args$args;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Hashed build assets are immutable — cache hard.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # SPA fallback so react-router deep links (e.g. /habit/3) resolve.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
